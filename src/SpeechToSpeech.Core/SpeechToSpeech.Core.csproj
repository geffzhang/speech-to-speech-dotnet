<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SpeechToSpeech.Core</RootNamespace>
    <Description>管线运行时、消息契约、配置与后端注册表。</Description>
    <!-- 只为 Json/RelaxedJsonEncoder：自定义 JavaScriptEncoder 的抽象方法签名带 char*，
         没有非 unsafe 的替代。除此之外 Core 里不应出现 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 流式分离的状态机本身零依赖（无模型运行时），管线这一级只是驱动它。 -->
    <ProjectReference Include="..\SpeechToSpeech.Audio.Diarization\SpeechToSpeech.Audio.Diarization.csproj" />
  </ItemGroup>

</Project>
